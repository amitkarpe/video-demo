# GitHub Actions version of site/deploy.sh. To adopt it (needs a token or login with the `workflow` scope):
#   1. copy this file to .github/workflows/pages.yml
#   2. Settings -> Pages -> Build and deployment -> Source: "GitHub Actions" (instead of the gh-pages branch)
# It builds site/ on every push to main that touches site/ or films/ (the transcripts), and deploys to GitHub Pages.
name: Showcase site
on:
  push:
    branches: [main]
    paths: ['site/**', 'films/**']
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: npm, cache-dependency-path: site/package-lock.json }
      - run: npm ci --no-audit --no-fund
        working-directory: site
      - run: npx astro build && touch dist/.nojekyll
        working-directory: site
      - uses: actions/upload-pages-artifact@v3
        with: { path: site/dist }
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment: { name: github-pages, url: '${{ steps.deployment.outputs.page_url }}' }
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
